#!/usr/bin/python3 -I
"""Privileged helper limited to the Raspberry Pi PWM fan, with no user paths."""
import os
from pathlib import Path
import re
import sys


def fan_pwm():
    for hw in sorted(Path('/sys/class/hwmon').glob('hwmon*')):
        try:
            if (hw / 'name').read_text(encoding='ascii').strip() != 'pwmfan':
                continue
            device = hw.resolve(strict=True)
            if not device.is_relative_to(Path('/sys/devices')):
                continue
            pwm = device / 'pwm1'
            if pwm.is_file():
                return pwm
        except OSError:
            continue
    raise RuntimeError('Supported PWM fan not found')


def safe_pwm(value):
    # Apply the high-temperature guard even when the helper is invoked directly.
    for zone in sorted(Path('/sys/class/thermal').glob('thermal_zone*')):
        try:
            if (zone / 'type').read_text(encoding='ascii').strip() == 'cpu-thermal':
                temp = int((zone / 'temp').read_text(encoding='ascii').strip())
                return 255 if temp < 0 or temp >= 70000 else value
        except (OSError, ValueError):
            continue
    return 255


def main(args):
    if os.geteuid() != 0:
        raise RuntimeError('Root privileges required')
    if args == ['probe']:
        pwm = fan_pwm()
        if not os.access(pwm, os.W_OK):
            raise RuntimeError('PWM control is not writable')
        return
    if len(args) != 2 or args[0] != 'set' or not re.fullmatch(r'(?:0|[1-9][0-9]{0,2})', args[1]):
        raise ValueError('Usage: pi-workbench-fan probe | set 0..255')
    value = int(args[1])
    if value > 255:
        raise ValueError('PWM must be in the range 0..255')
    value = safe_pwm(value)
    pwm = fan_pwm()
    with pwm.open('w', encoding='ascii') as stream:
        stream.write(str(value) + '\n')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, RuntimeError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)

